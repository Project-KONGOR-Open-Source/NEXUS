<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>exe</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <!-- INFO: The Problem Is That The .NET 11 SDK Generates "dotnet watch" Browser Assets For Every Web SDK Project And Exposes Them To Referencing Web Projects, Which Then Fail To Build Because Those Assets Have No Matching Endpoints; This Project Serves No Static Web Assets, So Disabling Them Is Safe -->
        <!-- TODO: Look Into This Again On The Next .NET SDK Update, And Remove This Workaround If The SDK No Longer Exposes These Assets To Referencing Projects -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.1" />
        <PackageReference Include="PhpSerializerNET" Version="2.1.2" />
        <PackageReference Include="srp" Version="1.0.7" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Web Portal's Own Font Files, Copied Into The Output, So That The Message Of The Day And The Announcement Pages Show The Same Font As The Portal -->
        <Content Include="../DAWNBRINGER.WebPortal.UI/wwwroot/fonts/ubuntu-*.ttf" Link="Resources/Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../ASPIRE.Common/ASPIRE.Common.csproj" />
        <ProjectReference Include="../MERRICK.DatabaseContext/MERRICK.DatabaseContext.csproj" />
    </ItemGroup>

</Project>
